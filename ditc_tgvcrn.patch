+import argparse
+import pickle
+import numpy as np
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import os
+
+def calc_ITE(x_outs_cf):
+    max_p = 250  # pose
+    max_y = 1000 # milage
+    if 0:
+        ITE = np.zeros((x_outs_cf.shape[0],),dtype=float)
+        for s in range(0,x_outs_cf.shape[0]):
+            milage0 = 0
+            milage1 = 0
+            for i in range(40,x_outs_cf.shape[1]):
+                dX0 = np.sqrt((x_outs_cf[s,i,1,0]-x_outs_cf[s,i-1,1,0])**2 + (x_outs_cf[s,i,2,0]-x_outs_cf[s,i-1,2,0])**2)
+                dX1 = np.sqrt((x_outs_cf[s,i,1,1]-x_outs_cf[s,i-1,1,1])**2 + (x_outs_cf[s,i,2,1]-x_outs_cf[s,i-1,2,1])**2)
+                milage0 += dX0
+                milage1 += dX1
+            ITE[s] = max_p * (milage0-milage1)
+    else:
+        ITE = max_y * (x_outs_cf[:,-1,70,0] - x_outs_cf[:,-1,70,1])
+        
+    return ITE
+
+
+def draw_fig(args,res):
