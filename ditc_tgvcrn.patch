+                self.gru_micro2 = nn.GRU(n_X_unpermute*2, rnn_micro_dim, n_layers, dropout=0.5)
+        else:
+            z_dim = n_X_features
+            self.gru_micro = nn.GRU(y_dim+z_dim, rnn_micro_dim, n_layers, dropout=0.5)
+            if not theory:
+                self.gru_micro2 = nn.GRU(n_X_unpermute+z_dim, rnn_micro_dim, n_layers, dropout=0.5)
+
+    def reset_h(self,batchSize,n_agents_,device):
+        self.h_micro = [torch.zeros((self.n_layers, batchSize, self.rnn_micro_dim),device=device) for i in range(self.n_agents)]
+        if n_agents_ > self.n_agents:
+            self.h_micro2 = [torch.zeros((self.n_layers, batchSize, self.rnn_micro_dim),device=device) for i in range(n_agents_-self.n_agents)]
+        else:
+            self.h_micro2 = []
+
+    def get_h_last(self):
+        micro_in = [[] for _ in range(len(self.h_micro)+len(self.h_micro2))]
+        for ii in range(len(self.h_micro)):
+            micro_in[ii] = self.h_micro[ii][-1]
+        for ii in range(len(self.h_micro2)):
+            micro_in[len(self.h_micro)+ii] = self.h_micro2[0][-1]
+        micro_in = torch.stack(micro_in,dim=1)
+        #print(micro_in.size()) # [batchSize,n_agents,rnn_micro_dim]
+        return micro_in
+
+    def forward(self,x_1,dec_in,dec_in_,batchSize):
