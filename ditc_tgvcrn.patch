+import torch.nn as nn
+import torch
+import numpy as np
+from utils import batch_error
+
+class Loss_all(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.a_or_ipw_losses = []
+        self.outcome_losses = []
+        self.L_kls = []
+        self.L_recXs = []
+        self.L_fails = []
+        self.L_curves = []
+
+    def register_info(self,x_inputs,args,lengths):
+        self.time_length = x_inputs.shape[1]-1
+        if not args.variable_length:
+            self.mean_time_length = self.time_length-args.burn_in0-1
+        else:
+            self.mean_time_length = float(torch.mean(lengths-1)-args.burn_in0-1)
+
+        self.x_dim = args.x_dim_permuted//args.n_agents
+        n_agents = args.n_agents
+        self.n_agents_ = n_agents if "T" in args.model and args.dim_rec_global == 0 else n_agents+1
+                
+    def forward(self,a_or_ipw_outputs,f_outcome_out,x_out,fr_targets,targets,
+                x_inputs,L_kl,lengths,Pred_X,criterion,args,obs_w,weights):
+
+        batchSize = f_outcome_out.shape[0]
+
+        (lambda_weight,lambda_X,lambda_KL,lambda_event) = weights
+
+        self.register_info(x_inputs,args,lengths)
+
+        a_or_ipw_loss = self.calc_a_or_ipw_loss(a_or_ipw_outputs,fr_targets,
+                       lengths,Pred_X,criterion,args,obs_w,batchSize)
+        self.a_or_ipw_losses.append(a_or_ipw_loss.item())
+    
+        outcome_loss = self.calc_outcome_loss(a_or_ipw_outputs,f_outcome_out,fr_targets,targets,
+                       lengths,Pred_X,args,obs_w,batchSize)
+        self.outcome_losses.append(outcome_loss.item())
+
+        L_kl /= batchSize
+        self.L_kls.append(L_kl.item())
+        
+        if Pred_X:
+            L_recX = self.calc_covariate_loss(x_out,x_inputs,lengths,args,obs_w,batchSize)
+            self.L_recXs.append(L_recX.item())
+            if lambda_event is not None:
+                assert 'carla' == args.data, f'event loss is not implemented for {args.data}'
+                fail_loss, curve_loss = self.calc_event_loss(x_out,x_inputs,lengths,args,obs_w,batchSize)
+                self.L_fails.append(fail_loss.item())   
+                self.L_curves.append(curve_loss.item())  
+        
+        # total loss
+        loss = a_or_ipw_loss * lambda_weight + outcome_loss
+        if Pred_X:
+            loss += L_recX[0]*lambda_X
+            if lambda_event is not None:
+                loss += fail_loss*lambda_event
+                loss += curve_loss*lambda_event
+        
+        if lambda_KL is not None:
+            loss += L_kl[0]*lambda_KL
+        
+        return loss
+    
+    def calc_covariate_loss(self,x_out,x_inputs,lengths,args,obs_w,batchSize):
+        L_recX = torch.zeros(1)
+        time_length, mean_time_length, x_dim, n_agents_ = self.time_length, self.mean_time_length, self.x_dim, self.n_agents_
+        
+        for i in range(args.burn_in0+1,time_length): # time
+            if args.variable_length:
+                non_nan = lengths>=obs_w-i
+                for k in range(n_agents_): # n_agents+args.dim_rec_global:
+                    if k < args.n_agents:
+                        x_dim_out = x_dim
+                        if 'carla' == args.data:
+                            x_dim_out = args.x_dim_predicted//args.n_agents
+                        L_recX += batch_error(x_out[:,i,k*x_dim:k*x_dim+x_dim_out], x_inputs[:,i,k*x_dim:k*x_dim+x_dim_out],index=non_nan)
+                    else:
+                        k2 = args.x_dim_permuted+args.dim_rec_global 
+                        L_recX += batch_error(x_out[:,i,args.x_dim_permuted:k2+1], x_inputs[:,i,args.x_dim_permuted:k2+1],index=non_nan)
+            else:
+                assert 'boid' == args.data
+                for k in range(args.n_agents+args.dim_rec_global):
+                    if k < args.n_agents:
+                        L_recX += batch_error(x_out[:,i,k*x_dim+2:k*x_dim+4], x_inputs[:,i,k*x_dim+2:k*x_dim+4])
+                    else:
+                        k2 = args.x_dim_permuted+k-args.n_agents
+                        L_recX += batch_error(x_out[:,i,k2:k2+1], x_inputs[:,i,k2:k2+1])
+
+        L_recX /= mean_time_length*(args.n_agents+args.dim_rec_global)*batchSize # 
+    
+        return L_recX
+
+        
+    def calc_event_loss(self,x_out,x_inputs,lengths,args,obs_w,batchSize):
+        fail_loss = torch.zeros(1)
+        curve_loss = torch.zeros(1)
+
+        time_length, mean_time_length, x_dim, n_agents_ = self.time_length, self.mean_time_length, self.x_dim, self.n_agents_
+        
+        for i in range(args.burn_in0+1,time_length): # time
+            if args.variable_length:
+                non_nan = lengths>=obs_w-i
+                fail_loss += torch.sum(non_nan.squeeze()*torch.abs(x_out[:,i,-1] - x_inputs[:,i+1,-1]) ) 
+                for k in range(n_agents_):
+                    curve_loss += batch_error(x_out[:,i,k*x_dim+3:k*x_dim+5], x_out[:,i-1,k*x_dim+3:k*x_dim+5],index=non_nan)
+
+        fail_loss /= mean_time_length*(args.n_agents-1)*batchSize
+        curve_loss /= mean_time_length*(args.n_agents-1)*batchSize
+    
+        return fail_loss, curve_loss
+
+    def calc_a_or_ipw_loss(self,a_or_ipw_outputs,fr_targets,lengths,Pred_X,criterion,args,obs_w,batchSize):
+        a_or_ipw_loss = torch.zeros(1)
+        
+        time_length, mean_time_length = self.time_length, self.mean_time_length
+
+        a_or_ipw_outputs = torch.cat(a_or_ipw_outputs, dim=1)
+
+        if Pred_X:
+            if "B" in args.model:
+                ps = torch.sigmoid(a_or_ipw_outputs)
+                for i in range(args.burn_in0+1,time_length): # time
+                    # propensity score
+                    if args.variable_length:
+                        non_nan = lengths>=obs_w-i
+                        if "Ne" in args.model:
+                            a_or_ipw_loss -= criterion(non_nan*ps[:,i], non_nan*fr_targets[:, i].float(), reduction='sum')
+                        else:
+                            a_or_ipw_loss += criterion(non_nan*ps[:,i], non_nan*fr_targets[:, i].float(), reduction='sum')
+                    else:
+                        if "Ne" in args.model:
+                            a_or_ipw_loss -= criterion(ps[:,i], fr_targets[:, i].float(), reduction='sum')
+                        else:
+                            a_or_ipw_loss += criterion(ps[:,i], fr_targets[:, i].float(), reduction='sum')
+                a_or_ipw_loss = a_or_ipw_loss/mean_time_length/batchSize
+        else:
+            for i in range(args.burn_in0+1,time_length):
+                a_or_ipw_pred_norm = a_or_ipw_outputs[:,i]
+                if args.variable_length:
+                    non_nan = lengths>=obs_w-i
+                    a_or_ipw_loss += criterion(non_nan*a_or_ipw_pred_norm, non_nan*fr_targets[:, i].float(), reduction='sum')
+                else:
+                    a_or_ipw_loss += criterion(a_or_ipw_pred_norm, fr_targets[:, i].float(), reduction='sum')
+                    
+            a_or_ipw_loss = a_or_ipw_loss/mean_time_length/batchSize
+
+        return a_or_ipw_loss
+
+    def calc_outcome_loss(self,a_or_ipw_outputs,f_outcome_out,fr_targets,targets,lengths,Pred_X,args,obs_w,batchSize):
+        outcome_loss = torch.zeros(1)
+        
+        time_length, mean_time_length = self.time_length, self.mean_time_length
+        t_pred = 1 if args.y_pred else 0
+
+        if Pred_X:
+            for i in range(args.burn_in0+1,time_length): # time
+                if args.variable_length:
+                    non_nan = lengths>=obs_w-i
+                    outcome_loss += torch.sum(non_nan.squeeze()*torch.abs(f_outcome_out[:,i] - targets[:,i+t_pred]) )
+                else:
+                    outcome_loss += torch.sum(torch.abs(f_outcome_out[:,i] - targets[:,i+t_pred]) )
+        else:
+            a_or_ipw_outputs = torch.cat(a_or_ipw_outputs, dim=1)
+            ps = torch.sigmoid(a_or_ipw_outputs)
+            weights = torch.zeros_like(a_or_ipw_outputs)
+            for i in range(args.burn_in0+1,time_length):
+                for j in range(a_or_ipw_outputs.size(0)): # batch
+                    p_treated = torch.where(fr_targets[j] == 1)[0].size(0) / fr_targets.size(1)
+                    if fr_targets[j,i] != 0:
+                        weights[j,i] += p_treated / ps[j,i] if ps[j,i] > 1e-3 else p_treated / 1e-3
+                    else:
+                        weights[j,i] += (1 - p_treated) / (1 - ps[j,i]) if 1-ps[j,i] > 1e-3 else (1 - p_treated) / 1e-3
+
+                weights2 = torch.where(weights[:,i] >= 100, torch.Tensor([100]).to(weights.device), weights[:,i])
+                weights3 = torch.where(weights2 <= 0.01, torch.Tensor([0.01]).to(weights.device), weights2)
+                if args.variable_length:
+                    non_nan = lengths>=obs_w-i
+                    outcome_loss += torch.sum(weights3*torch.abs(non_nan*f_outcome_out[:,i] - non_nan*targets[:,i+t_pred]) )
+                else:
+                    outcome_loss += torch.sum(weights3*torch.abs(f_outcome_out[:,i] - targets[:,i+t_pred]) )
+
+        outcome_loss = outcome_loss/mean_time_length/batchSize
+        if torch.sum(torch.isnan(outcome_loss))>0:
+            import pdb; pdb.set_trace()
+    
+        return outcome_loss
+
+
+    def display_loss(self, epoch, model_name, Pred_X):
+        epoch_losses_a_or_ipw = np.mean(self.a_or_ipw_losses)
+        outcome_losses_mean = np.mean(self.outcome_losses)
+        outcome_losses_std = np.std(self.outcome_losses)
+        print('Epoch: {}, a_or_ipw loss: {:.4f}, Outcome loss: {:.4f} $\pm$ {:.4f}'.format(epoch, epoch_losses_a_or_ipw, outcome_losses_mean, outcome_losses_std), flush=True)
+        if Pred_X:
+            if len(self.L_fails) > 0:
+                str_fail_loss = ', L_fail: {:.4f}'.format(np.mean(self.L_fails))
+            else:
+                str_fail_loss = ''
+            if len(self.L_curves) > 0:
+                str_curve_loss = ', L_curve: {:.4f}'.format(np.mean(self.L_curves))
+            else:
+                str_curve_loss = ''
+
+            L_recXs_mean = np.mean(np.sqrt(self.L_recXs))
+            L_recXs_std = np.std(np.sqrt(self.L_recXs))
+            if 'V' in model_name:
+                L_kls = np.mean(self.L_kls)
+                print('Epoch: {}, L_kls: {:.4f}, L_recXs: {:.4f} $\pm$ {:.4f}'.format(epoch, L_kls, L_recXs_mean, L_recXs_std)+str_fail_loss+str_curve_loss, flush=True)
+            else:
+                print('Epoch: {}, L_recXs: {:.4f} $\pm$ {:.4f}'.format(epoch, L_recXs_mean, L_recXs_std)+str_fail_loss+str_curve_loss, flush=True)
