+                x_outs_cf = []
+                x_outs_true = []
+            x_inputs_f, x_static_inputs_f, lengths_all,indices_all = [],[],[],[]
+
+            for x_inputs, x_static_inputs, x_fr_inputs, targets, lengths, indices, x_fr_all, x_all, targets_all, x_fr_opt in dataloader:
+                fr_targets = x_fr_inputs
+                if eval_use_cuda:
