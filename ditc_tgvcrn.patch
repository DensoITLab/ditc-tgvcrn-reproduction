+import torch.nn as nn
+import torch
+
+
+class Collision(nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+
+    def compute_collisions(self,input,batchSize,x_dim,n_agents):
+        raise NotImplementedError()
+
+class Collision_carla(Collision):
+    def __init__(self,max_p) -> None:
+        super().__init__()
+        self.max_p = max_p
+        print('compute collisions by MLP')
+        self.collision = nn.Sequential(
+            nn.Linear(4, 8), # 1+
+            nn.Softplus(),
+            nn.Linear(8, 1), # 
+            nn.Sigmoid(),
+        )
+
+    def forward(self,input,batchSize,x_dim,n_agents):
+        ## for carla
+        temperature = 0.1
+        collision_pred = torch.zeros((batchSize,n_agents-1,2),device=input.device)
+        for k in range(1,n_agents):
+            input_collision = self._compute_collision(input,x_dim,n_agents,k)
+            collision_pred[:,k-1,1:2] = torch.sigmoid((input_collision[:,0:1] - 0.5/self.max_p - 2.0/self.max_p*self.collision(input_collision[:,1:]))*self.max_p)
+            collision_pred[:,k-1,0] = 1-collision_pred[:,k-1,1]
+        return torch.max(collision_pred[:,:,0],1)[0]
+
+    def _compute_collision(self,pred,x_dim,n_agents,k):
+        extra_dim = 4
+        ego_pos = pred[:,:-extra_dim].reshape(-1,n_agents,x_dim)[:,0,1:3] 
+        other_pos = pred[:,:-extra_dim].reshape(-1,n_agents,x_dim)[:,k,1:3]
+        ego_size = pred[:,:-extra_dim].reshape(-1,n_agents,x_dim)[:,0,5:7] 
+        other_size = pred[:,:-extra_dim].reshape(-1,n_agents,x_dim)[:,k,5:7]
+        tmp_dist = torch.norm(ego_pos-other_pos,p=2,dim=1)
+        if torch.sum(torch.isnan(tmp_dist)):
+            import pdb; pdb.set_trace()
+        # tmp_dist = 1/(1e-6+torch.norm(ego_pos-other_pos,p=2,dim=1))
+        return torch.cat([tmp_dist.unsqueeze(1),ego_size,other_size],1)
