+import argparse
+import pickle
+import numpy as np
+import matplotlib.pyplot as plt
+
+
+def flatten_valid(x):
+    """NaN/inf を除いて 1 次元化する。"""
+    x = np.asarray(x).reshape(-1)
+    x = x[np.isfinite(x)]
+    return x
+
+
+def plot_hist(values_dict, title, output_path, bins=50, density=True):
+    plt.figure(figsize=(7, 4))
+
+    for label, values in values_dict.items():
+        values = flatten_valid(values)
+        if len(values) == 0:
+            continue
+        plt.hist(values, bins=bins, alpha=0.45, density=density, label=f"{label} (n={len(values)})")
+
+    plt.title(title)
+    plt.xlabel("Outcome value")
+    plt.ylabel("Density" if density else "Count")
+    plt.legend()
+    plt.tight_layout()
+    plt.savefig(output_path, dpi=200)
+    plt.close()
+
+    print(f"Saved: {output_path}")
+
+
+def summarize(name, values):
+    values = flatten_valid(values)
+    if len(values) == 0:
+        print(f"{name}: empty")
+        return
+
+    print(f"\n{name}")
+    print(f"  n      = {len(values)}")
+    print(f"  mean   = {np.mean(values):.6f}")
+    print(f"  std    = {np.std(values):.6f}")
+    print(f"  min    = {np.min(values):.6f}")
+    print(f"  p01    = {np.percentile(values, 1):.6f}")
+    print(f"  p05    = {np.percentile(values, 5):.6f}")
+    print(f"  p50    = {np.percentile(values, 50):.6f}")
+    print(f"  p95    = {np.percentile(values, 95):.6f}")
+    print(f"  p99    = {np.percentile(values, 99):.6f}")
+    print(f"  max    = {np.max(values):.6f}")
+
+    # 2値っぽい outcome の確認用
+    near_zero = np.mean(np.isclose(values, 0.0, atol=1e-6))
+    near_one = np.mean(np.isclose(values, 1.0, atol=1e-6))
+    print(f"  ratio ~= 0: {near_zero:.4f}")
+    print(f"  ratio ~= 1: {near_one:.4f}")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--pkl", type=str, required=True, help="Path to saved result pkl")
+    parser.add_argument("--prefix", type=str, default="outcome_dist", help="Output file prefix")
+    parser.add_argument("--bins", type=int, default=50)
+    parser.add_argument("--count", action="store_true", help="Use count instead of density")
+    args = parser.parse_args()
+
+    with open(args.pkl, "rb") as f:
+        res = pickle.load(f)
+
+    result, outcomes, covariates, others = res
+
+    # has_GT=True: Boid / CARLA
+    # outcomes = [f_outcome_true, cf_outcome_true, f_outcome_outputs, cf_outcome_outputs]
+    #
+    # has_GT=False: NBA
+    # outcomes = [f_outcome_true, f_outcome_outputs_long, f_outcome_outputs, cf_outcome_outputs]
+    #
+    # cf_outcome_true があるかどうかは形や名前だけでは完全には分からないので，
+    # ここでは「第2要素も true として扱える場合」と「NBA の long pred の場合」の両方に対応する。
+
+    f_outcome_true = outcomes[0]
+    second = outcomes[1]
+    f_outcome_outputs = outcomes[2]
+    cf_outcome_outputs = outcomes[3]
+
+    summarize("f_outcome_true", f_outcome_true)
+    summarize("outcomes[1]  # cf_outcome_true or f_outcome_outputs_long", second)
+    summarize("f_outcome_outputs", f_outcome_outputs)
+    summarize("cf_outcome_outputs", cf_outcome_outputs)
+
+    density = not args.count
+
+    # factual true vs factual pred
+    plot_hist(
+        {
+            "factual true": f_outcome_true,
+            "factual pred": f_outcome_outputs,
+        },
+        title="Factual outcome distribution",
+        output_path=f"{args.prefix}_factual.png",
+        bins=args.bins,
+        density=density,
+    )
+
+    # counterfactual pred
+    plot_hist(
+        {
+            "counterfactual pred": cf_outcome_outputs,
+        },
+        title="Counterfactual predicted outcome distribution",
+        output_path=f"{args.prefix}_counterfactual_pred.png",
+        bins=args.bins,
+        density=density,
+    )
+
