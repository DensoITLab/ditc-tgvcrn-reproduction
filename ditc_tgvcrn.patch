+import torch
+import torch.optim as optim
+from loss_all import Loss_all
+from tqdm import tqdm
+import numpy as np
+
+def trainInitIPTW(model, train_loader, val_loader, args, epochs, criterion, save_model=None):
+
+    obs_w = args.observation_window
+    # Train network
+    best_loss_val = torch.tensor(float('inf'))
+    if not args.has_GT:
+        CF = False
+    else:
+        CF = True
+
+    optimizer = optim.Adam(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
+    scheduler = optim.lr_scheduler.ExponentialLR(optimizer, gamma=0.95)
+
+    no_update = 0 
+    for epoch in range(epochs):
+        model.train()
+        lr = optimizer.param_groups[0]["lr"]
+        print(f'Training epoch {epoch}, lr {lr}')
+        loss_comp = Loss_all()
+
+        for x_inputs, x_static_inputs, x_fr_inputs, targets, lengths, _,_,_,_,_ in tqdm(train_loader): # x_all, x_fr_all, targets_all,x_fr_opt 
+            fr_targets = x_fr_inputs
+            x_inputs, x_static_inputs, x_fr_inputs = x_inputs.cuda(), x_static_inputs.cuda(), x_fr_inputs.cuda()
+            targets, fr_targets = targets.cuda(), fr_targets.cuda()
+            if args.variable_length:
+                lengths = lengths.cuda()
+            else:
+                lengths = []
+            
+            if args.lambda_KL is not None:
+                a_or_ipw_outputs, f_outcome_out, _, _, L_kl, x_out,_ = model(x_inputs, x_static_inputs, fr_targets, targets, cf_treatment=None, Train=True, lengths=lengths)
+            else:
+                a_or_ipw_outputs, f_outcome_out, _, _, x_out,_ = model(x_inputs, x_static_inputs, fr_targets, targets, cf_treatment=None)
+                L_kl = torch.zeros(1)
+            #f_treatment = torch.where(fr_targets.sum(1) > 0, torch.Tensor([1]), torch.Tensor([0]))
+
+            f_outcome_out = torch.stack(f_outcome_out,dim=1).squeeze()
+
+            loss = loss_comp(a_or_ipw_outputs,f_outcome_out,x_out,fr_targets,targets,
+                             x_inputs,L_kl,lengths,model.Pred_X,criterion,args,obs_w,
+                             (args.lambda_weight,args.lambda_X,args.lambda_KL,args.lambda_event))
+
+            optimizer.zero_grad()
+            loss.backward()
+
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 20)
+
+            optimizer.step()
+
+        
+        scheduler.step()
+        loss_comp.display_loss(epoch, args.model, model.Pred_X)    
+
+        print('Validation:')
+        model.eval()
+        pehe_val, _, mse_val, loss_val = model.test(val_loader, criterion, args, epoch, eval_use_cuda=True, CF=CF)
+
+        if loss_val < best_loss_val:
+            best_loss_val = loss_val
+            if save_model is not None:
+                print('Best model. Saving to {0}\n'.format(save_model))
+                torch.save(model, save_model)
+        elif np.isnan(loss_val) or (epoch==0 and loss_val == best_loss_val):
+            print('loss is nan or inf')
+            import pdb; pdb.set_trace()
+        else:
+            no_update += 1
+            if no_update >= 3:
+                model = torch.load(save_model)    
+                print('since no update continues {0} times, best model was loaded'.format(no_update))
+                no_update = 0
