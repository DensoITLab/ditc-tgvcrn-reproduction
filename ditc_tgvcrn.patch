diff --git a/gnn.py b/gnn.py
new file mode 100755
index 0000000..6c93e18
--- /dev/null
+++ b/gnn.py
@@ -0,0 +1,164 @@
+import torch.nn as nn
+import numpy as np
+import torch
+from utils import MLP, weights_init
+
+class GNN(nn.Module):
+    def __init__(self):
+        super().__init__()
+
+    def _make_edge_node(self,dataset,n_agents):
+        if dataset == 'nba' or dataset == 'carla':
+            self.n_edge_type = 2
+            self.n_node_type = 2
+        else:
+            self.n_edge_type = 0
+            self.n_node_type = 0
+        
+        # rel_rec, rel_send with numpy
+        off_diag = np.ones([n_agents, n_agents]) - np.eye(n_agents)
+
+        rel_rec = np.array(self._encode_onehot(np.where(off_diag)[0]), dtype=np.float32)
+        rel_send = np.array(self._encode_onehot(np.where(off_diag)[1]), dtype=np.float32)
+        rel_rec = torch.FloatTensor(rel_rec)
+        rel_send = torch.FloatTensor(rel_send)
+
+        if dataset == 'nba':
+            # corresponding with rel_rec/rel_send 
+            edge_type = torch.zeros(1,n_agents*(n_agents-1),2)
+            nonball_index = torch.arange(0,n_agents*(n_agents-1),(n_agents-1))[1:-1]
+            edge_type[:,nonball_index,0] = 1 # non-ball -> non-ball: [1 0] (receiver) :-(n_agents-1)?
+            edge_type[:,-(n_agents-1):,1] = 1 # non-ball -> ball: [0 1] (sender) OK
+
+            node_type = torch.zeros(1,n_agents,2)
+            node_type[:,:-1,0] = 1 # non-ball: [1 0] OK
+            node_type[:,-1,1] = 1 # ball: [0 1] OK
+        elif dataset == 'carla':
+            edge_type = torch.zeros(1,n_agents*(n_agents-1),2)
+            edge_type[:,:(n_agents-1),0] = 1 # ego -> ego: [1 0] (receiver) OK
+            ego_index = torch.where(rel_send[:,0]==1)[0]
+            edge_type[:,ego_index,1] = 1 # ego -> non-ego: [0 1] (sender) (n_agents-1):?
+
+            node_type = torch.zeros(1,n_agents,2)
+            node_type[:,0,0] = 1 # ego: [1 0] OK 
+            node_type[:,1:,1] = 1 # non-ego: [0 1] OK
+        else:
+            edge_type = None
+            node_type = None
+        self.rel_rec = rel_rec.cuda()
+        self.rel_send = rel_send.cuda()
+        self.edge_type = edge_type.cuda() if edge_type is not None else None
+        self.node_type = node_type.cuda() if node_type is not None else None
+
+    def _edge2node(self,x, rel_rec, rel_send, node_type):
+        # x: (batch,agents*(agents-1),hidden)
+        # rel_rec: (agents*(agents-1),agents)
+        # incoming: (batch,agents,hidden)
+        # node_type: (batch,agents,2)
+        incoming = torch.matmul(rel_rec.t(), x)
+        if node_type is not None:
+            incoming = torch.cat([incoming, node_type], dim=2)
+        return incoming / incoming.size(1)
+
+    def _node2edge(self,x, rel_rec, rel_send, edge_type):
+        # x: (batch,agents,hidden)
+        # rel_rec,rel_send: (agents*(agents-1),agents)
+        # edge_type: (batch,agents*(agents-1),2)
+        receivers = torch.matmul(rel_rec, x) # (batch,agents*(agents-1),hidden)
+        senders = torch.matmul(rel_send, x) # (batch,agents*(agents-1),hidden)
+        if edge_type is not None:
+            edges = torch.cat([senders, receivers, edge_type], dim=2)
+        else:
+            edges = torch.cat([senders, receivers], dim=2)
+        return edges
+
+    def _encode_onehot(self,labels):
+        classes = set(labels)
+        classes_dict = {c: np.identity(len(classes))[i, :] for i, c in
+                        enumerate(classes)}
+        labels_onehot = np.array(list(map(classes_dict.get, labels)),
+                                dtype=np.int32)
+        return labels_onehot
+
+class GNN1(GNN):
+    def __init__(self,dataset,n_agents,n_feat,n_out):
+        super().__init__()
+        self._make_edge_node(dataset,n_agents)
+        
+        n_hid = n_out
+        
+        # prior only
+        self.mlp1 = nn.ModuleList([nn.ModuleList()])
+        self.mlp2 = nn.ModuleList([nn.ModuleList()])
+        
+        do_prob = 0
+
+        self.mlp1[0] = MLP(n_feat, n_hid, n_hid, do_prob)
+        self.mlp2[0] = MLP(n_hid * 2 + self.n_edge_type, n_hid, n_hid, do_prob)
+
+        self.mlp1[0].apply(weights_init)
+        self.mlp2[0].apply(weights_init)
+
+    def forward(self, x, ped): # 0: prior, 1:encoder, 2:decoder
+        assert ped == 0
+        rel_rec, rel_send = self.rel_rec, self.rel_send
+        edge_type, node_type = self.edge_type, self.node_type
+        batchSize = x.shape[0]
+        if self.edge_type is not None:
+            edge_type = edge_type.repeat(batchSize,1,1)
+            node_type = node_type.repeat(batchSize,1,1)
+
+        x = self.mlp1[ped](x)  # 2-layer ELU net per node # [128, 5, 8]
+
+        x = self._node2edge(x, rel_rec, rel_send, edge_type) # [128, 20, 18]
+        x = self.mlp2[ped](x)
+        return x
+
+
+class GNN2(GNN):
+    def __init__(self,dataset,n_agents,n_feat,z_dim_each,n_out):
+        super().__init__()
+        self._make_edge_node(dataset,n_agents)
+
+        n_hid = n_out
+        n_gnn = 3 # 1: RNN, 3: VRNN
+        
+        self.mlp1 = nn.ModuleList([nn.ModuleList() for i in range(n_gnn)])  
+        self.mlp2 = nn.ModuleList([nn.ModuleList() for i in range(n_gnn)])  
+        self.mlp3 = nn.ModuleList([nn.ModuleList() for i in range(n_gnn)])  
+
+        for ped in range(n_gnn): # 0: prior, 1:encoder, 2:decoder
+            if ped <= 1:
+                n_in = n_feat # +rnn_micro_dim #*self.n_agents # 
+            elif ped == 2:
+                n_in = z_dim_each # +rnn_micro_dim 
+
+            do_prob = 0
+
+            self.mlp1[ped] = MLP(n_in, n_hid, n_hid, do_prob)
+            self.mlp2[ped] = MLP(n_hid * 2 + self.n_edge_type, n_hid, n_hid, do_prob)
+            self.mlp3[ped] = MLP(n_hid + self.n_node_type, n_hid, n_out, do_prob)
+
+            self.mlp1[ped].apply(weights_init)
+            self.mlp2[ped].apply(weights_init)
+            self.mlp3[ped].apply(weights_init)
+
+    def forward(self, x, ped): # 0: prior, 1:encoder, 2:decoder
+        rel_rec, rel_send = self.rel_rec, self.rel_send
+        edge_type, node_type = self.edge_type, self.node_type
+        batchSize = x.shape[0]
+        if self.edge_type is not None:
+            edge_type = edge_type.repeat(batchSize,1,1)
+            node_type = node_type.repeat(batchSize,1,1)
+
+        # x = [batch,K(=agents),n_in]
+        x = self.mlp1[ped](x)  # 2-layer ELU net per node # [batch,K(=agents),n_hid]=[256, 10, 8]
+
+        x = self._node2edge(x, rel_rec, rel_send, edge_type) # [batch, K(K-1), 2*n_hid+n_edge_type]
+        x = self.mlp2[ped](x) # [batch, K(K-1), n_hid]
+
+        x = self._edge2node(x, rel_rec, rel_send, node_type) #[batch, K, n_hid+n_node_type]
+        x = self.mlp3[ped](x) #[batch, K, n_out]
+
+        return x 
+
