@@ -0,0 +1,146 @@
+import argparse
+import pickle
+from pathlib import Path
+
+import numpy as np
+import matplotlib.pyplot as plt
+from sklearn.metrics import mean_squared_error
+
+
+def flatten_valid(x):
+    x = np.asarray(x).reshape(-1)
+    return x[np.isfinite(x)]
+
+
+def summarize_distribution(name, y):
+    y = flatten_valid(y)
+    print(f"\n[{name}]")
+    print(f"n      : {len(y)}")
+    print(f"mean   : {np.mean(y):.8f}")
+    print(f"std    : {np.std(y):.8f}")
+    print(f"min    : {np.min(y):.8f}")
+    print(f"p01    : {np.percentile(y, 1):.8f}")
+    print(f"p05    : {np.percentile(y, 5):.8f}")
+    print(f"p50    : {np.percentile(y, 50):.8f}")
+    print(f"p95    : {np.percentile(y, 95):.8f}")
+    print(f"p99    : {np.percentile(y, 99):.8f}")
+    print(f"max    : {np.max(y):.8f}")
+
+    near_zero = np.mean(np.isclose(y, 0.0, atol=1e-6))
+    near_one = np.mean(np.isclose(y, 1.0, atol=1e-6))
+    print(f"ratio ~= 0 : {near_zero:.6f}")
+    print(f"ratio ~= 1 : {near_one:.6f}")
+
+
+def constant_baselines(name, y):
+    y = flatten_valid(y)
+
+    constants = {
+        "zero": 0.0,
+        "mean": float(np.mean(y)),
+        "median": float(np.median(y)),
+    }
+
+    # 2値っぽい outcome のとき用。
+    # 0/1 に近い値が多い場合は majority class baseline として使う。
+    y_binary_like = np.logical_or(
+        np.isclose(y, 0.0, atol=1e-6),
+        np.isclose(y, 1.0, atol=1e-6),
+    )
+    if np.mean(y_binary_like) > 0.95:
+        p_one = np.mean(np.isclose(y, 1.0, atol=1e-6))
+        majority = 1.0 if p_one >= 0.5 else 0.0
+        constants["majority_binary"] = majority
+
+    print(f"\n[Constant predictor baselines: {name}]")
+    print("predictor\tconstant\tRMSE")
+    for label, c in constants.items():
+        pred = np.full_like(y, fill_value=c, dtype=float)
+        rmse = mean_squared_error(y, pred, squared=False)
+        print(f"{label}\t{c:.8f}\t{rmse:.8f}")
+
+
+def plot_outcome_distribution(name, y, output_path, bins=50, density=False):
+    y = flatten_valid(y)
+
+    plt.figure(figsize=(6.5, 4.0))
+    plt.hist(y, bins=bins, density=density, alpha=0.85)
+    plt.xlabel("Outcome value")
+    plt.ylabel("Density" if density else "Count")
+    plt.title(f"{name} outcome distribution")
+
+    # mean / median を補助線として入れる
+    plt.axvline(np.mean(y), linestyle="--", linewidth=1.2, label=f"mean={np.mean(y):.3g}")
+    plt.axvline(np.median(y), linestyle=":", linewidth=1.2, label=f"median={np.median(y):.3g}")
+    plt.legend()
+
+    plt.tight_layout()
+    plt.savefig(output_path, dpi=250)
+    plt.close()
+    print(f"saved: {output_path}")
+
+
+def load_outcomes(pkl_path):
+    with open(pkl_path, "rb") as f:
+        res = pickle.load(f)
+
+    result, outcomes, covariates, others = res
+    return outcomes
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--pkl", required=True, help="Path to result pkl saved by model.test(save=True)")
+    parser.add_argument(
+        "--mode",
+        choices=["has_gt", "no_gt"],
+        required=True,
+        help="has_gt: Boid/CARLA, no_gt: NBA",
+    )
+    parser.add_argument("--prefix", default=None, help="Output prefix")
+    parser.add_argument("--bins", type=int, default=50)
+    parser.add_argument("--density", action="store_true", help="Plot density instead of count")
+    args = parser.parse_args()
+
+    pkl_path = Path(args.pkl)
+    prefix = args.prefix or pkl_path.with_suffix("").name
+
+    outcomes = load_outcomes(pkl_path)
+
+    if args.mode == "has_gt":
+        # Boid / CARLA:
+        # outcomes = [f_outcome_true, cf_outcome_true, f_outcome_outputs, cf_outcome_outputs]
+        f_outcome_true = outcomes[0]
+        cf_outcome_true = outcomes[1]
+
+        targets = {
+            "factual_true": f_outcome_true,
+            "counterfactual_true": cf_outcome_true,
+        }
+
+    else:
+        # NBA:
+        # outcomes = [f_outcome_true, f_outcome_outputs_long, f_outcome_outputs, cf_outcome_outputs]
+        # 反事実 true は存在しないので，true outcome として使えるのは factual true のみ。
+        f_outcome_true = outcomes[0]
+
+        targets = {
+            "factual_true": f_outcome_true,
+        }
+
+    for name, y in targets.items():
+        summarize_distribution(name, y)
+        constant_baselines(name, y)
+
+        out_path = f"{prefix}_{name}_outcome_distribution.png"
+        plot_outcome_distribution(
+            name=name,
+            y=y,
+            output_path=out_path,
+            bins=args.bins,
+            density=args.density,
+        )
+
+
+if __name__ == "__main__":
+    main()
